# Soubory, které běží na Linuxu, musí mít LF i při úpravách z Windows.
# CRLF v shell skriptu nebo systemd jednotce se projeví jako záhadné
# "bad interpreter" nebo tiše nefunkční jednotka.
*.sh            text eol=lf
*.service       text eol=lf
*.timer         text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf
*.py            text eol=lf
