# Tokeny pro bota. Nahraď hodnoty svými a NIKDY tenhle soubor necommituj.
# Ostrá verze patří do /etc/slevy-bot/env s právy 600.

TELEGRAM_BOT_TOKEN=sem-token-od-BotFather
TELEGRAM_CHAT_ID=sem-tvoje-chat-id

# Volitelné. Bez nich bot běží dál, jen s menším pokrytím:
#   OPENROUTER_API_KEY — AI soudce pro položky, které heuristika neocení
#   ITAD_API_KEY       — referenční ceny her z IsThereAnyDeal
OPENROUTER_API_KEY=
ITAD_API_KEY=
