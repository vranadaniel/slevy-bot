[Unit]
Description=Hlídané trasy — nejlepší letenka podle zadání
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=slevy
Group=slevy
WorkingDirectory=/opt/slevy-bot
EnvironmentFile=/etc/slevy-bot/env
ExecStart=/opt/slevy-bot/.venv/bin/python -m src.main --watch

# Jedno hlídání je řádově deset požadavků na Ryanair, a to jen když je
# na řadě přepočet cen. Když se to nestihne za tři minuty, něco je špatně.
TimeoutStartSec=180

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/slevy-bot/data

[Install]
WantedBy=multi-user.target
